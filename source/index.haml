%section#hp-hero{:style => "background: #1a1e22; color: #fff; padding: 0; position: relative; overflow: hidden;"}
  / The banner is integrated as the soul of the Hero section
  .hero-banner-wrapper{:style => "width: 100%; line-height: 0;"}
    %img{:src => "/images/banners/banner.svg", :alt => "oVirt Logo", :style => "width: 100%; height: auto; display: block;"}

  .container{:style => "padding: 60px 0 100px 0;"}
    .row
      .col-md-8.col-md-offset-2.text-center
        %h1{:style => "font-size: 52px; font-weight: 800; letter-spacing: -2px; margin-bottom: 20px; line-height: 1;"}
          The Engine of
          %span{:style => "color: #0088CE;"} Open
          Virtualization.
        %p{:style => "font-size: 22px; opacity: 0.8; font-weight: 300; margin-bottom: 40px;"}
          Scalable. Secure. 100% Community-Driven. Manage your entire enterprise infrastructure from a single, powerful interface.
        .hero-actions
          %a.btn.btn-lg{:href => "/download/", :style => "background: #0088CE; color: #fff; padding: 18px 45px; font-weight: 700; border-radius: 50px; margin-right: 15px; border: none; transition: 0.3s;"}
            Deploy oVirt 4.5
          %a.btn.btn-lg{:href => "/community/", :style => "border: 2px solid #0088CE; color: #0088CE; padding: 16px 45px; font-weight: 700; border-radius: 50px; background: transparent;"}
            Join the Pulse

